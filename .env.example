# ====================================================================
# .env.example — Bu dosyayı `.env` olarak kopyala ve değerleri doldur.
# Asla .env dosyasını commit etme. (.gitignore'da ignored.)
# ====================================================================

# ── Django Güvenlik ────────────────────────────────────────────────
# Production için yeni bir secret üretmek:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Tarayıcı kaynak güveni (ngrok / Render / custom domain)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,https://*.ngrok-free.app

# ── TMDB API ───────────────────────────────────────────────────────
# https://www.themoviedb.org/settings/api  →  v3 auth key
TMDB_API_KEY=your_tmdb_api_key_here

# ── Email (Şifre Sıfırlama) — Opsiyonel ─────────────────────────────
# Gmail kullanıyorsan: hesabın için "App Password" oluştur:
# https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Otomatik Süper Kullanıcı (Production İlk Açılış İçin) ───────────
# Render'da set edersen, build sonrası `manage.py ensure_superuser`
# çalıştırıldığında bir admin hesabı garanti olur.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# ── AI Warmup ──────────────────────────────────────────────────────
# 1 → Sunucu açılışında AI modelini RAM'e yükleme (Render Free Tier'da OOM'u önler)
# 0 → Açılışta model RAM'e yüklensin (lokalde önerilir)
DISABLE_WARMUP=0
